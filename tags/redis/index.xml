        <span class="copy" title="Copy to clipboard"><i class="far fa-copy fa-fw" aria-hidden="true"></i></span>
    </div><div class="highlight"><pre tabindex="0" class="chroma"><code class="language-lua" data-lang="lua"><span class="line"><span class="cl"><span class="n">EVAL</span> <span class="s2">&#34;local cursor=&#39;0&#39;; repeat local result=redis.call(&#39;SCAN&#39;,cursor,&#39;MATCH&#39;,ARGV[1],&#39;COUNT&#39;,1000); cursor=result[1]; for _,key in ipairs(result[2]) do redis.call(&#39;DEL&#39;,key); end until cursor==&#39;0&#39;; return true;&#34;</span> <span class="mi">0</span> <span class="s2">&#34;user:*&#34;</span></span></span></code></pre></div></div>
<h3 id="count前缀key">COUNT(前缀KEY)</h3>
<div class="code-block code-line-numbers open" style="counter-reset: code-block 0">
