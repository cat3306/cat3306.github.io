        <span class="code-title"><i class="arrow fas fa-angle-right fa-fw" aria-hidden="true"></i></span>
        <span class="ellipses"><i class="fas fa-ellipsis-h fa-fw" aria-hidden="true"></i></span>
        <span class="copy" title="Copy to clipboard"><i class="far fa-copy fa-fw" aria-hidden="true"></i></span>
    </div><div class="highlight"><pre tabindex="0" class="chroma"><code class="language-lua" data-lang="lua"><span class="line"><span class="cl"> <span class="n">EVAL</span> <span class="s2">&#34;local cursor = &#39;0&#39;; local count = 0; repeat local result = redis.call(&#39;SCAN&#39;, cursor, &#39;MATCH&#39;, ARGV[1], &#39;COUNT&#39;, 1000); cursor = result[1]; count = count + #result[2]; until cursor == &#39;0&#39;; return count&#34;</span> <span class="mi">0</span> <span class="s2">&#34;ws:*&#34;</span></span></span></code></pre></div></div>
