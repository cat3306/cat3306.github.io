</span></span><span class="line"><span class="cl">    <span class="p">])</span>
</span></span><span class="line"><span class="cl">    <span class="p">..</span><span class="n">httpClientAdapter</span> <span class="o">=</span> <span class="n">Http2Adapter</span><span class="p">(</span>
</span></span><span class="line"><span class="cl">      <span class="n">ConnectionManager</span><span class="p">(</span>
</span></span><span class="line"><span class="cl">        <span class="nl">idleTimeout:</span> <span class="kd">const</span> <span class="n">Duration</span><span class="p">(</span><span class="nl">seconds:</span> <span class="m">10</span><span class="p">),</span>
</span></span><span class="line"><span class="cl">        <span class="nl">onClientCreate:</span> <span class="p">(</span><span class="n">_</span><span class="p">,</span> <span class="n">config</span><span class="p">)</span> <span class="o">=&gt;</span> <span class="n">config</span><span class="p">.</span><span class="n">onBadCertificate</span> <span class="o">=</span> <span class="p">(</span><span class="n">_</span><span class="p">)</span> <span class="o">=&gt;</span> <span class="kc">true</span><span class="p">,</span>
</span></span><span class="line"><span class="cl">      <span class="p">),</span>
</span></span><span class="line"><span class="cl">    <span class="p">);</span></span></span></code></pre></div></div>
